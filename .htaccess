# Настройки для хостинга с Apache (Timeweb и подобные)
Options -Indexes
# Служебные файлы и исходники не отдаём посетителям
RedirectMatch 404 /\.git
RedirectMatch 404 /\.gitignore$
RedirectMatch 404 ^/tools(/|$)
RedirectMatch 404 ^/README\.md$
RedirectMatch 404 ^/atlas\.html$
RedirectMatch 404 ^/earthatlas-upload\.zip$
AddDefaultCharset utf-8
AddType application/json .json
AddType font/woff2 .woff2
AddType image/svg+xml .svg
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain text/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
